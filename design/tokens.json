{
  "name": "Carbon Copy",
  "version": 1,
  "color": {
    "brand": {
      "ink": "#1E2A78",
      "carbon": "#3B4CCA",
      "canary": "#FFD23F",
      "canary-deep": "#E0AE12"
    },
    "light": {
      "window": "#F6F7FB",
      "surface": "#FFFFFF",
      "rail": "#ECEEF8",
      "line": "#B9C0E0",
      "line-soft": "#D3D8EE",
      "text": "#14172B",
      "text-muted": "#4A5180",
      "primary": "#1E2A78",
      "on-primary": "#FFFFFF",
      "link": "#3B4CCA",
      "accent": "#FFD23F",
      "on-accent": "#14172B",
      "ok": "#1B7F47",
      "warn": "#8A6000",
      "error": "#C8233B",
      "map-pending": "#DDE1F0",
      "map-done": "#1E2A78",
      "map-active": "#FFD23F",
      "map-bad": "#C8233B"
    },
    "dark": {
      "window": "#10132A",
      "surface": "#181C3A",
      "rail": "#141833",
      "line": "#3A4280",
      "line-soft": "#272D5C",
      "text": "#E8EAFB",
      "text-muted": "#A4ABD6",
      "primary": "#AAB6FF",
      "on-primary": "#10132A",
      "link": "#AAB6FF",
      "accent": "#FFD23F",
      "on-accent": "#14172B",
      "ok": "#5FD08C",
      "warn": "#FFD23F",
      "error": "#FF7A8A",
      "map-pending": "#272D5C",
      "map-done": "#AAB6FF",
      "map-active": "#FFD23F",
      "map-bad": "#FF7A8A"
    }
  },
  "type": {
    "display": {
      "family": "Bricolage Grotesque",
      "file": "fonts/bricolage-grotesque/BricolageGrotesque-Variable.ttf",
      "weight": 800,
      "use": "wordmark and pane titles only"
    },
    "body": {
      "family": "Segoe UI Variable Text",
      "fallback": "Segoe UI",
      "weights": [400, 600],
      "use": "every control, label and message"
    },
    "data": {
      "family": "IBM Plex Mono",
      "files": ["fonts/ibm-plex-mono/IBMPlexMono-Regular.ttf", "fonts/ibm-plex-mono/IBMPlexMono-Medium.ttf"],
      "weights": [400, 500],
      "use": "field captions, sector counts, addresses, sizes, speeds, times and the log"
    },
    "scale_pt": {
      "title": 17,
      "body": 9,
      "caption": 8,
      "data": 8.5,
      "data-large": 12
    }
  },
  "space_px": [0, 4, 8, 12, 16, 20, 24, 32],
  "radius_px": {
    "window": 8,
    "control": 5,
    "chip": 3,
    "card": 0,
    "map-cell": 1.5
  },
  "stroke_px": {
    "control": 1,
    "card": 1.5,
    "focus": 2
  },
  "size_px": {
    "control-height": 30,
    "rail-width": 168,
    "rail-item-height": 40,
    "rail-icon": 28,
    "main-window": [820, 500],
    "copy-shadow-offset": 4,
    "map-columns": 44,
    "map-rows-per-layer": 5,
    "map-gap": 2
  },
  "icon": {
    "grid": 64,
    "stroke": 3,
    "glyph-stroke": 2.3,
    "disc-center": [26, 26],
    "disc-radius": 20,
    "copy-offset": [4, 4],
    "badge-center": [46, 46],
    "badge-radius": 13.5,
    "sizes_px": [16, 20, 24, 32, 40, 48, 64, 128, 256]
  }
}
